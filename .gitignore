# Build output
/target/
apidoc/target/
fuzz/target/

# Library: CI and users resolve fresh. The runner and fuzz lockfiles are committed.
Cargo.lock
!apidoc/Cargo.lock
!fuzz/Cargo.lock

# Fuzzing: only fuzz_targets/, regression/, *.dict and Cargo.{toml,lock} are committed
fuzz/artifacts/
fuzz/corpus/
fuzz/coverage/

# Local-only: path overrides, quality-kit clone, agent state, editor/OS noise
.cargo/
.quality-kit/
.claude/
.workongoing
.jj/
.idea/
.vscode/
.DS_Store
*.swp
**/*.rs.bk
rustc-ice-*.txt

# Profiler output
perf.data*
*.profraw
*.profdata
flamegraph.svg
heaptrack.*.zst
callgrind.out.*
cachegrind.out.*
massif.out.*
mutants.out*/
